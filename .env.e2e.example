# Isolated stack for the opt-in live suites (composer test:integration, npm run test:e2e).
# Loaded when APP_ENV=e2e. Uses its own database and a DEV Pixelforge key: never the prod key.
APP_NAME="Pixel-Forge Studio"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pixelforge_e2e
DB_USERNAME=pixelforge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
# Dev key from the Pixelforge dashboard (separate from prod).
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_MARKUP=1.25
